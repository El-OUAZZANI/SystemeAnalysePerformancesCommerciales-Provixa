# Copier ce fichier en ".env" (à la racine, à côté de manage.py) et remplir les
# vraies valeurs. Le fichier ".env" n'est JAMAIS commité (voir .gitignore).

# --- Sécurité (production uniquement) ---
# DJANGO_SECRET_KEY=<générer une nouvelle clé, ne jamais réutiliser celle du code>
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=votredomaine.ma,www.votredomaine.ma
